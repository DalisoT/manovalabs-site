# ============================================================================
# MANOVA LABS — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
# Never commit secrets. Only NEXT_PUBLIC_* values are exposed to the client.
# ============================================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://manovalabs.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hello MANOVA LABS, I'd like to discuss a digital project."
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_EMAIL=hello@manovalabs.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_BOOKING_URL=

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI Provider ----------
# Set AI_PROVIDER to one of: openai | anthropic | google
# OpenAI-compatible endpoints (e.g. MiniMax) work via OPENAI_BASE_URL.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.chat/v1
OPENAI_MODEL=MiniMax-Text-01
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# ---------- Email (deferred — leads save to Supabase only) ----------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@manovalabs.com
# NOTIFICATION_EMAIL=hello@manovalabs.com

# ---------- WhatsApp Business (optional, degrades silently) ----------
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_RECIPIENT_NUMBER=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------- Security ----------
# Per-IP cap for /api/ai/chat. Integer.
AI_RATE_LIMIT_PER_HOUR=30