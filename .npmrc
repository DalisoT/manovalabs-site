# OpenNext 1.20.6's peer dep requires Next.js >=15.5.24.
# We're on 14.2.15 because of a security-patch lag and a desire
# to keep the same version across projects. The
# `--dangerouslyUseUnsupportedNextVersion` flag at build time handles
# the runtime check; this file lets `npm ci` succeed during install.
legacy-peer-deps=true